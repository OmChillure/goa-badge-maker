# Share links — the rendered badge PNG is uploaded here and the returned CDN
# URL is the share link. Get the token from the UploadThing dashboard.
# Server-side only; without it the "Get share link" button fails.
UPLOADTHING_TOKEN=""

# AI portrait generation (src/routes/api/generate-portrait.ts).
# Provisioned by Lovable Cloud — not available outside it, so this button
# fails on local/Vercel deploys until it is swapped for a direct provider.
LOVABLE_API_KEY=""
